# ─── Banco de Dados ───────────────────────────
# Em dev, deixe vazio para usar SQLite local (server/data.db)
# Em produção, aponte para um volume persistente (ex.: /data/data.db).
# Sem volume montado, o banco é apagado a cada deploy.
DB_PATH=

# ─── Auth ─────────────────────────────────────
JWT_SECRET=troque-por-uma-chave-forte-de-64-caracteres
AUDIT_HMAC_SECRET=troque-por-outra-chave-forte

# Chave de segurança da entrada da plataforma (/plataforma). Exigida além da
# senha: sem ela, o acesso da administração fica bloqueado.
ADMIN_SECURITY_KEY=

# Admin da plataforma — criado no primeiro boot se nenhum admin existir.
# O e-mail padrão é admin@rycs.pro; só preencha para usar outro.
# Sem ADMIN_PASSWORD o sistema gera uma senha e a imprime no log do deploy.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── IA (Anthropic) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Upload de Arquivos (S3 / Cloudflare R2) ──
S3_BUCKET=rycs-uploads
S3_REGION=auto
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── E-mail (Resend) ─────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=RYCS <cadastro@rycs.pro>

# ─── Pagamento (Asaas) ───────────────────────
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Fallback manual quando o gateway estiver desligado.
PIX_RECEBIMENTO=
PIX_TITULAR=RYCS Sales Solutions

# ─── App ──────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
# Defina no build do frontend quando API e site usarem domínios diferentes.
VITE_API_URL=http://localhost:3001
NODE_ENV=development

# Somente desenvolvimento local: admin, vendedor ou empresa. Nunca use em produção.
DEV_SEM_LOGIN=

# ─── RYCS Audit Engine ────────────────────────
# Todas OPCIONAIS: o motor funciona com os padrões abaixo.
#
# Timeout de cada chamada a provedor externo (ms). Padrão 30000.
AUDIT_PROVIDER_TIMEOUT_MS=
# Tolerância de distância na auditoria de visita presencial (metros).
# A precisão declarada pelo aparelho é somada a este valor. Padrão 150.
AUDIT_GEO_TOLERANCIA_M=
# Tentativas da fila antes de mandar a auditoria para revisão humana. Padrão 3.
AUDIT_MAX_TENTATIVAS=
# Intervalo do worker que drena a fila de auditoria (ms). Padrão 4000.
AUDIT_WORKER_INTERVALO_MS=
#
# Provedores de IA. Sem chave, a capacidade fica INDISPONÍVEL e os critérios
# que dependem dela ficam inconclusivos — a ação vai para revisão humana.
# Nenhum resultado é fabricado na ausência de provedor.
#
# ANTHROPIC_API_KEY (já declarada acima) habilita: semântica e visão.
# Transcrição (speech-to-text) não tem provedor implementado: exige adicionar
# um adapter em server/services/audit/providers/ (OpenAI, Deepgram, Google,
# AWS Transcribe ou Azure Speech).
