# ─── Banco de Dados ───────────────────────────
# Em dev, deixe vazio para usar SQLite local (server/data.db)
# Em produção, use a connection string do PostgreSQL
DATABASE_URL=

# ─── Auth ─────────────────────────────────────
JWT_SECRET=troque-por-uma-chave-forte-de-64-caracteres

# ─── IA (Anthropic) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Upload de Arquivos (S3 / Cloudflare R2) ──
S3_BUCKET=rycs-uploads
S3_REGION=auto
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── E-mail (Resend) ─────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=RYCS <noreply@rycs.com.br>

# ─── Pagamento (Asaas) ───────────────────────
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# ─── App ──────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
