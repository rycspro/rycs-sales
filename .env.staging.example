# ─────────────────────────────────────────────────────────────────────────────
# RYCS — AMBIENTE DE STAGING (isolado, sem dados financeiros reais)
#
# Copie para .env.staging e preencha com segredos EXCLUSIVOS de staging.
# NUNCA reaproveite segredos/credenciais de produção aqui. NUNCA commite o
# arquivo preenchido. Este .example não contém segredos reais.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=staging
RYCS_ENVIRONMENT=staging
PORT=3001

# ─── Banco (descartável, separado de produção) ───────────────────────────────
# Volume dedicado de staging — jamais aponte para o /data de produção.
DB_PATH=/data-staging/staging.db

# ─── Auth (segredos EXCLUSIVOS — gere novos, 64+ chars) ──────────────────────
# Ex.: openssl rand -hex 48
JWT_SECRET=GERE_UM_SEGREDO_EXCLUSIVO_DE_STAGING
AUDIT_HMAC_SECRET=GERE_OUTRO_SEGREDO_EXCLUSIVO_DE_STAGING
ADMIN_SECURITY_KEY=GERE_UMA_CHAVE_DE_ENTRADA_EXCLUSIVA

# Admin de staging (criado no 1º boot se nenhum admin existir). E-mail fictício.
ADMIN_EMAIL=admin-staging@rycs.test
ADMIN_PASSWORD=GERE_UMA_SENHA_FORTE_DE_STAGING

# ─── Reautenticação financeira — LIGADA só em staging (tarefa 7) ─────────────
REAUTH_FINANCEIRO=1

# ─── Pagamento (Asaas) — HOMOLOGAÇÃO/SANDBOX, credenciais exclusivas ──────────
# Conta sandbox do Asaas (não a de produção). Sem chave, o gateway fica
# desligado e o fluxo cai no fallback manual.
ASAAS_ENV=sandbox
ASAAS_API_KEY=COLE_A_CHAVE_SANDBOX_DO_ASAAS
# Token do header asaas-access-token que o webhook exige (header-only + timingSafeEqual).
ASAAS_WEBHOOK_TOKEN=GERE_UM_TOKEN_DE_WEBHOOK_EXCLUSIVO
# Em testes automatizados, ASAAS_BASE_URL_TESTE aponta o cliente para um gateway
# fake local; em staging real deixe vazio para usar a API sandbox do Asaas.
ASAAS_BASE_URL_TESTE=

# ─── Uploads (S3/R2) — BUCKET EXCLUSIVO de staging, PRIVADO ───────────────────
# Bucket separado, ACL privada (sem leitura pública), download só por URL assinada.
S3_BUCKET=rycs-uploads-staging
S3_REGION=auto
S3_ENDPOINT=https://COLOQUE_O_ENDPOINT_DE_STAGING
S3_ACCESS_KEY=CHAVE_DE_ACESSO_EXCLUSIVA_DE_STAGING
S3_SECRET_KEY=SEGREDO_EXCLUSIVO_DE_STAGING

# ─── App / CORS ──────────────────────────────────────────────────────────────
FRONTEND_URL=https://staging.rycs.test
PUBLIC_URL=https://staging.rycs.test
CORS_ORIGINS=https://staging.rycs.test
VITE_API_URL=https://staging.rycs.test

# ─── Integrações externas: deixe vazias em staging salvo se houver sandbox ────
# (sem chave, o recurso é ignorado com segurança)
ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=RYCS Staging <no-reply@rycs.test>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
META_APP_ID=
META_APP_SECRET=

# Fallback manual de Pix (fictício em staging)
PIX_RECEBIMENTO=
PIX_TITULAR=RYCS Staging

# NUNCA usar em staging público:
DEV_SEM_LOGIN=
